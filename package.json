{
  "name": "lynx",
  "productName": "Lynx",
  "version": "0.1.32",
  "description": "Workspaces made of custom UIs, MCP connectors and agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "updates": {
    "feed": "https://lynx.railcode.dev/updates/{platform}-{arch}.json",
    "download": ""
  },
  "marketplace": {
    "api": "https://lynx-marketplace.skaldapp.workers.dev"
  },
  "scripts": {
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "app": "node scripts/make-app.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "node scripts/e2e.mjs",
    "test": "node scripts/unit.mjs",
    "dist": "node scripts/dist.mjs",
    "check": "npm run typecheck && npm test && npm run test:agents && npm run test:opencode && npm run build",
    "test:agents": "node scripts/agentd.mjs",
    "test:opencode": "node scripts/opencode.mjs",
    "test:opencode:native": "node scripts/opencode-smoke.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "preview:check": "node scripts/preview-checks.mjs",
    "preview:shot": "node scripts/preview-shot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "1.18.0",
    "cron-parser": "5.10.2",
    "double-metaphone": "2.0.1",
    "effect": "^4.0.1",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "monaco-editor": "0.57.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "playwright": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "sherpa-onnx-win-arm64": "1.13.8"
  },
  "engines": {
    "node": ">=24"
  }
}
